# Test contour only. Copy to .env on the server and chmod 600.
# Real values belong in server/GitLab protected variables, never in Git.
CADDY_IMAGE=caddy:2.11.4-alpine
# Built from tourism-platform/docker/postgres (PostGIS 16 + pgvector).
POSTGRES_IMAGE=crimeatrip/postgis-pgvector:16-3.4
REDIS_IMAGE=redis:8.2-alpine
BACKEND_IMAGE=registry.gitlab.com/travel-platform2/tourism-backend:replace-with-commit-sha

API_HOST=test-api.example.invalid
ACME_EMAIL=ops@example.invalid

POSTGRES_DB=tourism_test
POSTGRES_USER=tourism_app
# Generate URL-safe random values; do not reuse these placeholders.
POSTGRES_PASSWORD=replace-with-url-safe-random-value
REDIS_PASSWORD=replace-with-url-safe-random-value

JWT_SIGNING_KEY=replace-with-url-safe-random-value-at-least-32-chars
JWT_ISSUER=crimeatrip-test
JWT_AUDIENCE=crimeatrip-mobile
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
# The test contour requires the real OTP code. Read it from the database:
#   SELECT phone_e164, debug_code, expires_at FROM auth_otp_challenges
#   ORDER BY created_at DESC LIMIT 5;
AUTH_OTP_ACCEPT_ANY=false
AUTH_OTP_STORE_DEBUG_CODE=true

# Phase 6.5 ops admin (/admin). Put real values only on the server .env (chmod 600)
# or in GitLab masked/protected variables — never commit them.
ADMIN_ENABLED=true
ADMIN_SESSION_SECRET=replace-with-url-safe-random-value-at-least-32-chars
ADMIN_BOOTSTRAP_LOGIN=ops
ADMIN_BOOTSTRAP_PASSWORD=replace-with-url-safe-random-value-at-least-12-chars

# AI planning. AI_PROVIDER can be switched from the admin runtime-config page,
# but the key and base URL are startup config and only come from here.
AI_PLANNING_ENABLED=false
AI_PROVIDER=mock
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_REPAIR_ATTEMPTS=1
GEMINI_API_KEY=
# Leave at the Google default unless the host cannot reach Google directly.
# The Moscow host cannot (400 FAILED_PRECONDITION, "User location is not
# supported"), so it uses the IP-restricted relay on the previous server:
#   GEMINI_BASE_URL=https://relay.86-106-20-132.sslip.io/v1beta
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# 2GIS TSP / Distance Matrix stay "stub" until deliberately switched on.
TSP_PROVIDER=stub
DISTANCE_MATRIX_PROVIDER=stub

# Optional FCM (system tray push). Minify the Firebase service account JSON to
# one line. Never commit the real value — only set it on the server .env.
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"crimeatrip-41d24",...}
# FCM_SERVICE_ACCOUNT_FILE=
